                    try await exportManager.export(image: testImage, options: options, cropper: cropper)
                } catch {
                    // Export may fail
                }
                semaphore.signal()
            }
            semaphore.wait()
        }

        // Cleanup
        try? FileManager.default.removeItem(at: outputFile)
    }
}
