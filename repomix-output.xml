    let scaleFactor: Double
    let windowID: CGWindowID?
}

struct CaptureResult: Sendable {
    let image: NSImage
    let mode: CaptureMode
    let metadata: CaptureMetadata
}
```
**Features**: Sendable protocol for thread safety

