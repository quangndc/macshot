            outline-offset: 2px;
        }

        /* ========================================
           Design Notes
           ======================================== */
        .design-notes {
            position: fixed;
            bottom: var(--space-4);
            right: var(--space-4);
            background: var(--bg-secondary);
            padding: var(--space-3);
            border-radius: var(--radius-medium);
            box-shadow: 0 4px 20px var(--shadow-medium);
            font-size: 11px;
            color: var(--text-secondary);
            max-width: 280px;
            z-index: 1000;
        }

        .design-notes h4 {
            font-size: 12px;
            font-weight: 600;
            margin-bottom: var(--space-2);
            color: var(--text-primary);
        }

        .design-notes ul {
            list-style: none;
            padding: 0;
        }

        .design-notes li {
            margin-bottom: var(--space-1);
            padding-left: var(--space-3);
            position: relative;
        }

        .design-notes li:before {
            content: '•';
            position: absolute;
            left: 0;
            color: var(--accent);
        }
    </style>
</head>
