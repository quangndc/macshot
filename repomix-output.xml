            Hotkey(keyCode: .q, modifiers: .command),         // Quit
            Hotkey(keyCode: .w, modifiers: .command),         // Close
            Hotkey(keyCode: .c, modifiers: .command),         // Copy
            Hotkey(keyCode: .v, modifiers: .command),         // Paste
