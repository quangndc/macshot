        XCTAssertFalse(engine.canUndo)
        XCTAssertFalse(engine.canRedo)
    }

    func testAddShape() {
        let rectangle = RectangleShape(rect: CGRect(x: 0, y: 0, width: 50, height: 50), style: .default)

